<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="267.0" prefWidth="560.0" style="-fx-background-color: #FFD1DC; -fx-background-radius: 30; -fx-border-color: black; -fx-border-radius: 30; -fx-border-width: 1;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="EventDetailsController">
   <children>
      <Button layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#handleBack" style="-fx-background-color: transparent;" text="&lt;--" font="$x1">
         <font>
            <Font name="System Bold" size="18.0" fx:id="x1" />
         </font>
      </Button>

      <Text fx:id="eventNameLabel" layoutX="100.0" layoutY="40.0" strokeType="OUTSIDE" strokeWidth="0.0" text="EVENT NAME" textAlignment="CENTER" wrappingWidth="360.0">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Text>

      <Text layoutX="60.0" layoutY="90.0" text="TIME:">
         <font><Font name="System Bold" size="14.0" /></font>
      </Text>
      <Text fx:id="timeLabel" layoutX="110.0" layoutY="90.0" text="12:00 - 14:00" />

      <Text layoutX="60.0" layoutY="130.0" text="LOCATION:">
         <font><Font name="System Bold" size="14.0" /></font>
      </Text>
      <Text fx:id="locationLabel" layoutX="145.0" layoutY="130.0" text="Library" />

      <Text layoutX="60.0" layoutY="170.0" text="TAGS:">
         <font><Font name="System Bold" size="14.0" /></font>
      </Text>
      <Text fx:id="tagsLabel" layoutX="110.0" layoutY="170.0" text="Study, Chat" />

      <Button fx:id="joinEventButton" layoutX="100.0" layoutY="210.0" mnemonicParsing="false" onAction="#handleJoinEvent" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #7ed957; -fx-background-radius: 15; -fx-text-fill: black;" text="JOIN EVENT" />
      
      <Button fx:id="ignoreButton" layoutX="270.0" layoutY="210.0" mnemonicParsing="false" onAction="#handleBack" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #fe7d7d; -fx-background-radius: 15; -fx-text-fill: black;" text="IGNORE REQUEST" />

      <Button fx:id="organiserButton" layoutX="440.0" layoutY="60.0" mnemonicParsing="false" onAction="#handleShowOrganiserProfile" style="-fx-background-color: #ffffff; -fx-background-radius: 10;" text="ORGANISER" />
   </children>
</AnchorPane>
