        <AnchorPane nodeOrientation="LEFT_TO_RIGHT" prefHeight="606.0" prefWidth="420.0" style="-fx-background-color: #FAEBD7;">
          <children>
                  <Circle fill="DODGERBLUE" layoutX="110.0" layoutY="114.0" radius="61.0" stroke="BLACK" />
                  <Button layoutX="41.0" layoutY="248.0" mnemonicParsing="false" onAction="#openMenu" prefHeight="30.0" prefWidth="139.0" style="-fx-background-color: #1A365D; -fx-background-radius: 15;" text="MENU" textFill="WHITE" />
                  
                  <Button fx:id="friendsButton" layoutX="41.0" layoutY="287.0" mnemonicParsing="false" onAction="#openFriends" prefHeight="30.0" prefWidth="139.0" style="-fx-background-color: #0c2545; -fx-background-radius: 15;" text="FRIENDS" textFill="WHITE" />
                  
                  <Button layoutX="41.0" layoutY="327.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="139.0" style="-fx-background-color: #1A365D; -fx-background-radius: 15;" text="SEARCH" textFill="WHITE" />
                  <Button layoutX="37.0" layoutY="184.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="146.0" style="-fx-background-color: #D4F1F4; -fx-text-fill: black; -fx-background-radius: 15;" textAlignment="CENTER" />
                  <Button layoutX="41.0" layoutY="392.0" mnemonicParsing="false" prefHeight="56.0" prefWidth="139.0" style="-fx-background-color: #1A365D; -fx-background-radius: 15;" text="CREATE EVENT" textFill="WHITE" />
                  <Button layoutX="14.0" layoutY="543.0" mnemonicParsing="false" prefHeight="38.0" prefWidth="112.0" style="-fx-background-color: #1A365D; -fx-background-radius: 15;" text="View Schedule" textFill="WHITE">
                     <font>
                        <Font size="8.0" />
                     </font>
                  </Button>
                  <AnchorPane layoutX="224.0" prefHeight="606.0" prefWidth="673.0">
                     <children>
                        <ScrollBar layoutX="666.0" orientation="VERTICAL" prefHeight="602.0" prefWidth="14.0" />
                        <Line endX="1.52587890625E-5" endY="604.0" startX="1.52587890625E-5" startY="-0.7999969720840454" stroke="#b4b4b4" />
                        <Text fill="#1a365d" layoutX="282.0" layoutY="131.0" strokeType="OUTSIDE" strokeWidth="0.0" text="FRIENDS">
                           <font>
                              <Font size="30.0" />
                           </font>
                        </Text>
                     </children>
                  </AnchorPane>
                  <ImageView fitHeight="164.0" fitWidth="163.0" layoutX="29.0" layoutY="33.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/profile.png" />
                     </image>
                  </ImageView>
